# GitHub org the dams-*-metadata repos live under
FCR_TO_OPEX_GITHUB_ORG=ucd-library

# GCS binary archive (production convention: gs://<bucket>/<slug>/...)
FCR_TO_OPEX_GCS_BUCKET=dams-collections-binary-backups

# Standard Google Application Default Credentials - path to a service-account JSON key.
# Read automatically by @google-cloud/storage; not a custom key in lib/config.js.
GOOGLE_APPLICATION_CREDENTIALS=

# Debug logging (lib/logger.js#debug only prints when this is exactly 'true')
FCR_TO_OPEX_DEBUG=
